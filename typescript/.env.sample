################################################################################
##  Application
################################################################################
# API server port.
PORT=3000

# Log verbosity for the application logger.
LOG_LEVEL=info

################################################################################
##  Database
################################################################################
# MySQL host. Use `db` when running through Docker Compose.
DB_HOST=localhost
# MySQL port.
DB_PORT=33306
# Database name / schema.
DB_SCHEMA=school-administration-system
# Database user.
DB_USER=root
# Database password.
DB_PW=password

# Sequelize connection pool acquisition timeout in milliseconds.
DB_POOL_ACQUIRE=30000
# Sequelize connection pool idle timeout in milliseconds.
DB_POOL_IDLE=10000
# Maximum number of pooled connections.
DB_POOL_MAX_CONN=10
# Minimum number of pooled connections.
DB_POOL_MIN_CONN=1
# SQL logging level for Sequelize.
DB_LOG_LEVEL=info

# Base URL for the bundled external student service.
EXTERNAL_STUDENT_SERVICE_URL=http://localhost:5000
