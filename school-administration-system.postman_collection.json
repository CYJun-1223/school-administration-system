{
  "info": {
    "_postman_id": "8fbb9a15-b9ad-400e-95cc-5e08ad061f3a",
    "name": "school-administration-system",
    "description": "Postman collection for the School Administration System API and bundled external student service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "11787500"
  },
  "item": [
    {
      "name": "Application API",
      "item": [
        {
          "name": "Healthcheck",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthcheck",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "healthcheck"
              ]
            },
            "description": "Check that the application API is running."
          },
          "response": []
        },
        {
          "name": "Upload CSV",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 204 No Content', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "type": "file",
                  "key": "data",
                  "contentType": "text/csv",
                  "src": "data.sample.csv"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload"
              ]
            },
            "description": "Upload CSV data using multipart form field `data`."
          },
          "response": []
        },
        {
          "name": "Get Students By Class Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('response body is JSON', function () {",
                  "  pm.response.to.be.json;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/class/{{classCode}}/students?offset={{offset}}&limit={{limit}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "class",
                "{{classCode}}",
                "students"
              ],
              "query": [
                {
                  "key": "offset",
                  "value": "{{offset}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                }
              ]
            },
            "description": "Return local and external students for a class in one paginated list."
          },
          "response": []
        },
        {
          "name": "Rename Class",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 204 No Content', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"className\": \"{{renamedClassName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/class/{{classCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "class",
                "{{classCode}}"
              ]
            },
            "description": "Rename a class by class code."
          },
          "response": []
        },
        {
          "name": "Get Workload Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('response body is JSON', function () {",
                  "  pm.response.to.be.json;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/workload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "workload"
              ]
            },
            "description": "Return teacher workload grouped by subject."
          },
          "response": []
        }
      ]
    },
    {
      "name": "External Student Service",
      "item": [
        {
          "name": "Get Student List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('response body is JSON', function () {",
                  "  pm.response.to.be.json;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{externalBaseUrl}}/students?class={{classCode}}&offset={{offset}}&limit={{limit}}",
              "host": [
                "{{externalBaseUrl}}"
              ],
              "path": [
                "students"
              ],
              "query": [
                {
                  "key": "class",
                  "value": "{{classCode}}"
                },
                {
                  "key": "offset",
                  "value": "{{offset}}"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}"
                }
              ]
            },
            "description": "Retrieve students from the bundled external student service."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
